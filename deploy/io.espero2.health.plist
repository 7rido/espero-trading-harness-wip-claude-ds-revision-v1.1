<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>io.espero2.health</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>cd __DIR__ &amp;&amp; /usr/bin/python3 scripts/health_check.py</string>
    </array>
    <key>WorkingDirectory</key><string>__DIR__</string>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>8</integer>
        <key>Minute</key><integer>30</integer>
    </dict>
    <key>RunAtLoad</key><false/>
    <key>StandardOutPath</key><string>__DIR__/logs/health-launchd.log</string>
    <key>StandardErrorPath</key><string>__DIR__/logs/health-launchd.err</string>
</dict>
</plist>
